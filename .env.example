# Copy this file to .env and replace every change-me value. Never commit .env.

# NVD API key used by the local OWASP Dependency-Check security scan.
NVD_API_KEY=change-me-nvd-api-key

# Google OAuth identity provider registered in the wornux Keycloak realm.
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me-google-client-secret

# Keycloak server administrator used only for realm administration/bootstrap.
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password

# Browser-login client: Keycloak client "inventory-management" and the Spring application must share this value.
KEYCLOAK_CLIENT_SECRET=change-me-inventory-management-client-secret

# Machine client: Keycloak client "inventory-automation" and JMeter must share this value.
KEYCLOAK_AUTOMATION_CLIENT_SECRET=change-me-inventory-automation-client-secret

# Initial application administrator account created in Keycloak; keep separate from the server administrator password.
KEYCLOAK_BOOTSTRAP_ADMIN_USER_PASSWORD=change-me-bootstrap-user-password

# Application PostgreSQL connection used by both PostgreSQL and Spring Boot.
DB_USERNAME=postgres
DB_PASSWORD=change-me-application-database-password

# Keycloak's dedicated PostgreSQL connection.
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-database-password

# Grafana administrator login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password

# Alertmanager sends Slack notifications through this Docker secret.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/example/example/example
