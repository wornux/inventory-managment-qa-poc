  "clients": [
    {
      "clientId": "inventory-management",
      "name": "Inventory Management web application",
      "description": "Confidential Vaadin web client",
      "rootUrl": "${APP_PUBLIC_URL}",
      "baseUrl": "${APP_PUBLIC_URL}/",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "redirectUris": [
        "${APP_PUBLIC_URL}/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "${APP_PUBLIC_URL}"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_PUBLIC_URL}/login"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    },
    {
      "clientId": "inventory-api-tools",
      "name": "Inventory API interactive tools",
      "description": "Public PKCE client for Swagger UI and Postman",
      "rootUrl": "${APP_PUBLIC_URL}",
      "enabled": true,
      "redirectUris": [
        "${APP_PUBLIC_URL}/swagger-ui/oauth2-redirect.html",
        "https://oauth.pstmn.io/v1/callback",
        "https://oauth.pstmn.io/v1/browser-callback"
      ],
      "webOrigins": [
        "${APP_PUBLIC_URL}"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    },
    {
      "clientId": "inventory-automation",
      "name": "Inventory API automation",
      "description": "Confidential service-account client for automated API consumers",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_AUTOMATION_CLIENT_SECRET}",
      "redirectUris": [],
      "webOrigins": [],
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "1800"
      },
      "protocolMappers": [
        {
          "name": "service account email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "email",
            "claim.value": "inventory-automation@wornux.local",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "syncMode": "IMPORT"
      }
    }
  ]
}
