otelcol.receiver.otlp "application" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.metrics.input]
    traces  = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "metrics" {
  output {
    metrics = [otelcol.exporter.prometheus.application.input]
  }
}

otelcol.exporter.prometheus "application" {
  forward_to = [prometheus.relabel.application.receiver]
}

prometheus.relabel "application" {
  forward_to = [prometheus.remote_write.prometheus.receiver]

  rule {
    target_label = "job"
    replacement  = "application"
  }
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

otelcol.processor.batch "traces" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

local.file_match "application" {
  path_targets = [{
    __path__     = "/var/log/application/application.json",
    service_name = "qa-final-project",
  }]
}

loki.source.file "application" {
  targets    = local.file_match.application.targets
  forward_to = [loki.process.application.receiver]
}

loki.process "application" {
  stage.json {
    expressions = {
      level = "level",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  stage.label_keep {
    values = ["service_name", "level"]
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
